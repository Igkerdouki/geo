OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Required for sponsor-powered discovery and retrieval:
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_UNLOCKER_ZONE=
# Neon: paste the pooled connection URL from Connect, keeping SSL parameters.
# Stores investigations and evidence snapshots; also reads pur_monthly when present.
# SQLite evidence storage is used when absent.
DATABASE_URL=
# Existing simulated spray feed is disabled by default.
GEO_ENABLE_LEGACY_SIMULATOR=0

# Enable pre-existing local PUR tables (county-wide context only).
GEO_PUR_DATABASE=0
# Optional separate historical database. Monthly queries fall back to DATABASE_URL.
# Legacy spray-event endpoints still require the original sprays schema.
PUR_DATABASE_URL=

# Optional external EPA MCP server (HTTPS Streamable HTTP); leave empty if unavailable.
EPA_MCP_URL=

# Optional AirNow API credential; the EPA drinking-water adapter does not need it.
AIRNOW_API_KEY=

# Optional equipment-ingestion bearer token. Leave empty to disable telemetry writes.
GEO_INGEST_TOKEN=

# Gemini is preferred when configured; keep credentials server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Same-provider fallback for rate limits / transient failures; blank disables it.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional Neon SQL-over-HTTPS when PostgreSQL TCP is unavailable.
GEO_NEON_HTTP=0

# Long-running servers run the hourly watch queue; Vercel uses authenticated Cron.
GEO_ENABLE_ALERT_WORKER=1
# Configure a random CRON_SECRET on Vercel (never commit its value).
