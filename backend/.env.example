OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Required for sponsor-powered discovery and retrieval:
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_UNLOCKER_ZONE=
# Neon: paste the pooled connection URL from Connect, keeping SSL parameters.
# Stores investigations and evidence snapshots; also reads pur_monthly when present.
# SQLite evidence storage is used when absent.
DATABASE_URL=
# Existing simulated spray feed is disabled by default.
GEO_ENABLE_LEGACY_SIMULATOR=0

# Enable pre-existing local PUR tables (county-wide context only).
GEO_PUR_DATABASE=0
# Optional separate historical database. Monthly queries fall back to DATABASE_URL.
# Legacy spray-event endpoints still require the original sprays schema.
PUR_DATABASE_URL=
