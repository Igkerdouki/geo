{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {"api/index.py": {"maxDuration": 300, "includeFiles": "backend/app/**"}},
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index"},
    {"source": "/health", "destination": "/api/index"},
    {"source": "/explorer", "destination": "/index.html"}
  ]
}
